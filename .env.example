# Slippery Fish — optional build-time configuration (copy to .env.local).
#
# EVERYTHING HERE IS PUBLIC. Vite inlines VITE_* values into the JavaScript
# that every player downloads. Never put secret keys, merchant secrets,
# admin tokens or passwords in this file. Leave a value empty to keep the
# matching feature switched off (the game then explains it is unavailable).
# See docs/SERVICES.md before filling anything in.

# Deployment base path. Leave unset for a relative build that works anywhere;
# the GitHub Actions workflow sets it automatically ("/<repo>" or "").
# BASE_PATH=/Slippery-Fish/

# development | staging | production (controls provider test/sandbox modes)
VITE_SERVICE_ENV=

# Online Ranked server (secure WebSocket). Not implemented server-side yet.
VITE_RANKED_SERVER_URL=

# Sign-in provider (public client id only; use OAuth/OIDC with PKCE).
VITE_AUTH_PROVIDER=
VITE_AUTH_PUBLIC_CLIENT_ID=

# Cloud save API base URL (your server).
VITE_CLOUD_SAVE_API=

# Rewarded ads: provider name + PUBLIC placement ids from the provider dashboard.
VITE_ADS_PROVIDER=
VITE_ADS_PLACEMENT_CONTINUE=
VITE_ADS_PLACEMENT_CHEST=
VITE_ADS_PLACEMENT_FISHING=

# Real-money payments: provider name + YOUR server's checkout endpoint.
VITE_PAYMENTS_PROVIDER=
VITE_PAYMENTS_CHECKOUT_API=

# Promotions JSON (https only).
VITE_REMOTE_CONFIG_URL=

# Legal & support links shown in Settings → Privacy & Legal. When empty, the
# bundled DRAFT pages in public/legal/ are used (they contain placeholders).
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=
VITE_SUPPORT_URL=
VITE_ACCOUNT_DELETION_URL=
VITE_PUBLISHER_WEBSITE_URL=
